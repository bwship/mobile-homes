# Copy to `.env.local` at the mobile-homes root.
# `npx convex dev` writes CONVEX_URL; Vite reads VITE_CONVEX_URL (set both, or rely on CONVEX_ prefix in vite.config).

VITE_CONVEX_URL=
CONVEX_URL=

# Google Maps — Maps JavaScript API, Places, Geocoding
VITE_GOOGLE_MAPS_API_KEY=

# Optional — password reset emails (Resend)
RESEND_API_KEY=
SITE_URL=http://localhost:5173
