{
  "name": "mh-marketplace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "convex dev",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "deploy:convex": "convex deploy",
    "seed": "npx convex run seed:seedDemo",
    "seed:bob": "npx convex run seed:seedBobAccounts",
    "seed:listings": "npx convex run seed:seedListings",
    "seed:tiny": "npx convex run seed:seedListings",
    "seed:images": "npx convex run seedImages:seedListingImages",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "convex": "^1.32.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "resend": "^6.9.2"
  }
}
